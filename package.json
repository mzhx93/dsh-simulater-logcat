{
  "name": "@mzhx93/dsh-simulater-logcat",
  "description": "Android device and emulator Logcat workbench for DeepSeek Harness, with explicit MuMu ADB connection recovery, live logs, and agent tools.",
  "version": "0.9.0",
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "^0.2.1-rc.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "files": [
    "lib/**/*.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "license": "Apache-2.0",
  "homepage": "https://github.com/mzhx93/dsh-simulater-logcat#readme",
  "bugs": {
    "url": "https://github.com/mzhx93/dsh-simulater-logcat/issues"
  },
  "keywords": ["dsh-plugin", "deepseek-harness", "android", "logcat", "adb", "mumu"],
  "scripts": {
    "check": "node --check lib/index.js && node --check lib/client.js",
    "test": "node --test test/*.test.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mzhx93/dsh-simulater-logcat.git"
  }
}
